NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Bot de Telegram (secretos: solo en .env.local o en el panel del hosting) ---
TELEGRAM_BOT_TOKEN=
# Texto aleatorio (letras, números, _ y -). Ej: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Usuario del bot sin @ (público). Muestra el botón en el footer.
NEXT_PUBLIC_TELEGRAM_BOT=

# --- LLM gratuito (Groq) ---
GROQ_API_KEY=
# Opcional: los modelos gratuitos cambian; revisa la lista vigente de Groq.
GROQ_MODEL=openai/gpt-oss-20b
