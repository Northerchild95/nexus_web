NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Bot de Telegram (secretos: solo en .env.local o en el panel del hosting) ---
TELEGRAM_BOT_TOKEN=
# Texto aleatorio (letras, números, _ y -). Ej: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Usuario del bot sin @ (público). Muestra el botón en el footer.
NEXT_PUBLIC_TELEGRAM_BOT=

# --- LLM gratuito (Groq) ---
GROQ_API_KEY=
# Opcional: los modelos gratuitos cambian; revisa la lista vigente de Groq.
GROQ_MODEL=openai/gpt-oss-20b

# --- Datos personales del bot (gastos, tareas, hábitos) ---
# Upstash Redis (capa gratuita): consola → tu base → pestaña "REST API"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Tu chat ID (escríbele /id al bot). Varios separados por coma. Solo ellos guardan datos.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Contacto público (opcionales: la sección y el footer solo muestran lo que definas) ---
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=

# --- Suscripción por correo (opcional: la sección se oculta si falta algo) ---
# Remitente: debe ser un correo verificado en tu proveedor (en Brevo: Senders → Add a sender).
EMAIL_FROM=
EMAIL_FROM_NAME=Nexus Life
# Elige UN proveedor. Brevo no exige dominio propio; Resend sí (para enviar a cualquier persona).
BREVO_API_KEY=
RESEND_API_KEY=
